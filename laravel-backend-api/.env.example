# ---------------------------------------------------------------
# Application
# ---------------------------------------------------------------
APP_NAME=AnchorlessTest
APP_ENV=local
APP_KEY=base64:s+goe6r8KecYGZ/F5ho9GASrKbYyirGVqcgFUjBBNec=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------
# Logging
# ---------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------
# Database (PostgreSQL via Sail)
# ---------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=laravel_backend_api
DB_USERNAME=sail
DB_PASSWORD=password

# ---------------------------------------------------------------
# Session & Caching
# ---------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=memcached

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------
# Mail (Mailpit)
# ---------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------
# Amazon S3 (unused by default)
# ---------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------
# Frontend (Vite)
# ---------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------
# RabbitMQ (optional)
# ---------------------------------------------------------------
RABBITMQ_USER=youruser
RABBITMQ_PASSWORD=yourpassword
RABBITMQ_VHOST=yourvhost
RABBITMQ_QUEUE=yourqueue

# ---------------------------------------------------------------
# MinIO (primary filesystem disk)
# ---------------------------------------------------------------
FILESYSTEM_DISK=minio
MINIO_ACCESS_KEY_ID=sail
MINIO_SECRET_ACCESS_KEY=password
MINIO_DEFAULT_REGION=us-east-1
MINIO_BUCKET=uploads
MINIO_URL=
MINIO_ENDPOINT=http://minio:9000
MINIO_USE_PATH_STYLE_ENDPOINT=true

# ---------------------------------------------------------------
# Reverb (WebSocket broadcasting)
# ---------------------------------------------------------------
REVERB_APP_ID=709753
REVERB_APP_KEY=go2nuvywabhcvw09rseg
REVERB_APP_SECRET=ncrnnjav9cdosn02eqao
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

